<?xml version="1.0" encoding="utf-8"?>
<!-- Input / SelectTrigger: rounded-lg border-input bg-card, ring on focus -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/qa_input_bg" />
            <stroke
                android:width="2dp"
                android:color="@color/qa_primary" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/qa_input_bg" />
            <stroke
                android:width="2dp"
                android:color="@color/qa_primary_30" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/qa_input_bg" />
            <stroke
                android:width="1dp"
                android:color="@color/qa_border" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
