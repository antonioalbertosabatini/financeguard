<?xml version="1.0" encoding="utf-8"?>
<!-- Button outline: border-border bg-background rounded-lg -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/qa_ripple">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/qa_outline_bg" />
            <stroke
                android:width="1dp"
                android:color="@color/qa_border" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</ripple>
