<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
    </style>

    <style name="Base.QuickAddDialog" parent="Theme.AppCompat.DayNight.Dialog">
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowCloseOnTouchOutside">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.2</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
        <item name="android:fontFamily">@font/dm_sans</item>
        <item name="fontFamily">@font/dm_sans</item>
        <item name="android:textColorPrimary">@color/qa_foreground</item>
        <item name="android:textColorSecondary">@color/qa_muted_fg</item>
        <item name="android:textColorHighlight">@color/qa_primary_30</item>
        <item name="colorPrimary">@color/qa_primary</item>
        <item name="colorPrimaryDark">@color/qa_primary</item>
        <item name="colorAccent">@color/qa_primary</item>
        <item name="colorControlActivated">@color/qa_primary</item>
        <item name="colorControlHighlight">@color/qa_ripple</item>
    </style>

    <style name="AppTheme.QuickAddDialog" parent="Base.QuickAddDialog" />

    <!-- Quick Add dialog building blocks, mirroring the web form components. -->
    <style name="QuickAdd" />

    <style name="QuickAdd.Title">
        <item name="android:textColor">@color/qa_foreground</item>
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">@font/dm_sans_semibold</item>
    </style>

    <style name="QuickAdd.Label">
        <item name="android:textColor">@color/qa_foreground</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/dm_sans_medium</item>
        <item name="android:layout_marginStart">6dp</item>
    </style>

    <style name="QuickAdd.Body">
        <item name="android:textColor">@color/qa_muted_fg</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>

    <style name="QuickAdd.LabelIcon">
        <item name="android:layout_width">14dp</item>
        <item name="android:layout_height">14dp</item>
        <item name="tint">@color/qa_muted_fg</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

    <style name="QuickAdd.Field">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:background">@drawable/qa_bg_input</item>
    </style>

    <style name="QuickAdd.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/dm_sans_medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
    </style>

    <style name="QuickAdd.Button.Primary">
        <item name="android:background">@drawable/qa_btn_primary</item>
        <item name="android:textColor">@color/qa_on_primary</item>
    </style>

    <style name="QuickAdd.Button.Outline">
        <item name="android:background">@drawable/qa_btn_outline</item>
        <item name="android:textColor">@color/qa_foreground</item>
    </style>
</resources>