<?xml version="1.0" encoding="utf-8"?>
<!-- SelectItem: icon + label, check mark on the selected entry. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="44dp"
    android:background="@drawable/qa_bg_popup_item"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingEnd="10dp">

    <ImageView
        android:id="@+id/quick_add_option_icon"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/quick_add_option_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/qa_foreground"
        android:textSize="14sp" />

    <ImageView
        android:id="@+id/quick_add_option_check"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginStart="8dp"
        android:importantForAccessibility="no"
        android:src="@drawable/lucide_check"
        app:tint="@color/qa_foreground" />
</LinearLayout>
