{
  "name": "financeguard",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "electron:dev": "electron .",
    "electron:build": "next build && electron-builder",
    "cap:sync": "next build && cap sync",
    "cap:ios": "next build && cap sync ios && cap open ios",
    "cap:android": "next build && cap sync android && cap open android",
    "android": "npm run cap:android",
    "ios": "npm run cap:ios",
    "icons:generate": "node assets/generate-icons.mjs && npx @capacitor/assets generate --ios --android"
  },
  "dependencies": {
    "@capacitor/core": "^8.4.1",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/preferences": "^8.0.1",
    "@hookform/resolvers": "^5.4.0",
    "@noble/hashes": "^2.2.0",
    "@supabase/supabase-js": "^2.108.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "jszip": "^3.10.1",
    "lowdb": "^7.0.1",
    "lucide-react": "^1.17.0",
    "next": "16.2.7",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.5.0",
    "react": "19.2.4",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.78.0",
    "recharts": "^3.8.1",
    "shadcn": "^4.11.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/ios": "^8.4.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "sharp": "^0.34.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.6"
  },
  "build": {
    "appId": "app.financeguard",
    "productName": "FinanceGuard",
    "beforeBuild": "electron/before-build.cjs",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**",
      "out/**",
      "!electron/before-build.cjs",
      "!**/node_modules/**"
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.finance",
      "electronLanguages": [
        "en",
        "it"
      ]
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage",
      "category": "Finance"
    }
  }
}
